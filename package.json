{
  "name": "codegym",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "jest --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "start": "node server.js",
    "dev": "nodemon --config nodemon.json server.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "remove-console": "node scripts/remove-console-all.js",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "lint-staged": {
    "*.js": [
      "node scripts/remove-console.js",
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.{json,md,css,scss,html}": [
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@google/genai": "^1.31.0",

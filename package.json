    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "globals": "^15.0.0",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "lint-staged": "^13.2.1",
    "nyc": "^17.1.0",
    "prettier": "^3.7.1",
    "supertest": "^7.1.4"

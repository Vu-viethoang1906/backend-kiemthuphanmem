    "@keycloak/keycloak-admin-client": "^26.4.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.2.2",
    "ecdsa-sig-formatter": "^1.0.11",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.1",
    "fuse.js": "^7.1.0",
    "googleapis": "^144.0.0",
    "groq-sdk": "^0.37.0",
    "helmet": "^7.2.0",

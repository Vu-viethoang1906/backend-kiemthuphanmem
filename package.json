    "jwks-rsa": "^3.2.0",
    "keycloak-admin": "^1.14.22",
    "keycloak-connect": "^26.1.1",
    "moment-timezone": "^0.6.0",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "pdfkit": "^0.17.2",

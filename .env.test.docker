# file này để cấu hình biến môi trường cho test trên docker


# Test Environment Variables
NODE_ENV=test
PORT=3006

# Database
DB_CONNECTION_STRING=mongodb://mongo-test:27017/ken_db_test?replicaSet=rs0&retryWrites=true&w=majority
DB_NAME=ken_db_test
MONGO_INITDB_DATABASE=ken_db_test
MONGO_URI=mongodb://mongo-test:27017/ken_db_test?replicaSet=rs0&retryWrites=true&w=majority
MONGO_PORT=27017
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# JWT
JWT_SECRET=test_jwt_secret_key_for_testing_only_do_not_use_in_production
JWT_REFRESH_SECRET=test_jwt_refresh_secret_key_for_testing_only_do_not_use_in_production
JWT_EXPIRES_IN=1h

# Keycloak Test Configuration
KEYCLOAK_BASE_URL=http://localhost:9090/auth
KEYCLOAK_REALM=testrealm
KEYCLOAK_RESOURCE=test-app
KEYCLOAK_PUBLIC_CLIENT=true
KEYCLOAK_CONFIDENTIAL_PORT=0
KEYCLOAK_SSL_REQUIRED=external

# CORS
CORS_ORIGIN=http://localhost:3001

# Email (Test - sử dụng mock hoặc test SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=test@example.com
MAIL_PASS=test_password
MAIL_FROM=noreply@ken-test.com

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads/test

# Logging
LOG_LEVEL=error

# MongoDB Express (Test UI)
MONGO_EXPRESS_PORT=8082
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=test123

# Node Version
NODE_VERSION=18
VERSION=test
